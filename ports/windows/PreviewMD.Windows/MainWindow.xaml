<Window
    x:Class="PreviewMD.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PreviewMD (Windows experiment)">
    <Grid x:Name="Root" AllowDrop="True" DragOver="RootDragOver" Drop="RootDrop">
        <WebView2 x:Name="Preview" />
        <Grid x:Name="EmptyState" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open" Click="OpenClicked" />
                    <MenuFlyoutItem Text="Showcase" Click="ShowcaseClicked" />
                </MenuFlyout>
            </Grid.ContextFlyout>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <TextBlock Text="PreviewMD" FontSize="28" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button Content="Open" Click="OpenClicked" />
                    <Button Content="Showcase" Click="ShowcaseClicked" />
                </StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
